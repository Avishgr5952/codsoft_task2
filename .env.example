# Database connection URL (PostgreSQL)
# For local zero-config testing, the embedded PostgreSQL server runs on localhost:5432 or 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinedesk?schema=public"

# Authentication secret for JWT tokens
JWT_SECRET="dinedesk-super-secure-jwt-secret-key-change-in-production-2026"

# Base URL for public links and API requests
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional embedded PG Server Port (defaults to 5432)
PG_PORT="5432"
